{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping qbit_exporter",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["qbittorrent", "torrent"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "label": "Datasource",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(qbittorrent_up, instance)",
        "hide": 0,
        "includeAll": true,
        "label": "Instance",
        "multi": false,
        "name": "instance",
        "query": { "query": "label_values(qbittorrent_up, instance)", "refId": "A" },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "qBittorrent",
  "uid": "qbittorrent-exporter",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "type": "stat",
      "title": "Status",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Down", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "Up", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "qbittorrent_up{instance=~\"$instance\"}", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Torrents",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "qbittorrent_torrents_total{instance=~\"$instance\"}", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Global ratio",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "qbittorrent_global_ratio{instance=~\"$instance\"}", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Free disk space",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "qbittorrent_free_space_on_disk_bytes{instance=~\"$instance\"}", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "DHT nodes",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "qbittorrent_dht_nodes{instance=~\"$instance\"}", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Peers",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "qbittorrent_peer_connections{instance=~\"$instance\"}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Transfer speed",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 1 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "upload" }, "properties": [ { "id": "custom.transform", "value": "negative-Y" } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "qbittorrent_dl_speed_bytes{instance=~\"$instance\"}", "legendFormat": "download", "refId": "A" },
        { "expr": "qbittorrent_up_speed_bytes{instance=~\"$instance\"}", "legendFormat": "upload", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "All-time transferred",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "qbittorrent_alltime_downloaded_bytes{instance=~\"$instance\"}", "legendFormat": "downloaded", "refId": "A" },
        { "expr": "qbittorrent_alltime_uploaded_bytes{instance=~\"$instance\"}", "legendFormat": "uploaded", "refId": "B" }
      ]
    },
    {
      "type": "piechart",
      "title": "Torrents by state",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value"] }, "pieType": "donut", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "qbittorrent_torrents_state_count{instance=~\"$instance\"}", "legendFormat": "{{state}}", "refId": "A" }
      ]
    },
    {
      "type": "bargauge",
      "title": "Torrents by category",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "qbittorrent_torrents_category_count{instance=~\"$instance\"}", "legendFormat": "{{category}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Disk cache",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "qbittorrent_read_cache_hits_ratio{instance=~\"$instance\"}", "legendFormat": "read hits", "refId": "A" },
        { "expr": "qbittorrent_read_cache_overload_ratio{instance=~\"$instance\"}", "legendFormat": "read overload", "refId": "B" },
        { "expr": "qbittorrent_write_cache_overload_ratio{instance=~\"$instance\"}", "legendFormat": "write overload", "refId": "C" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Download speed by category",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 1, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "qbittorrent_category_dl_speed_bytes{instance=~\"$instance\"}", "legendFormat": "{{category}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Upload speed by category",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 1, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "qbittorrent_category_up_speed_bytes{instance=~\"$instance\"}", "legendFormat": "{{category}}", "refId": "A" }
      ]
    },
    {
      "type": "bargauge",
      "title": "Ratio by tracker",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2, "min": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "qbittorrent_tracker_ratio{instance=~\"$instance\"}", "legendFormat": "{{tracker}}", "refId": "A" }
      ]
    },
    {
      "type": "table",
      "title": "Tracker totals",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Uploaded" }, "properties": [ { "id": "unit", "value": "bytes" } ] },
          { "matcher": { "id": "byName", "options": "Downloaded" }, "properties": [ { "id": "unit", "value": "bytes" } ] },
          { "matcher": { "id": "byName", "options": "Ratio" }, "properties": [ { "id": "unit", "value": "short" }, { "id": "decimals", "value": 2 } ] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Uploaded", "desc": true } ] },
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "instance": true, "job": true, "__name__": true },
            "renameByName": {
              "tracker": "Tracker",
              "Value #U": "Uploaded",
              "Value #D": "Downloaded",
              "Value #R": "Ratio",
              "Value #T": "Torrents"
            }
          }
        }
      ],
      "targets": [
        { "expr": "qbittorrent_tracker_uploaded_bytes{instance=~\"$instance\"}", "format": "table", "instant": true, "refId": "U" },
        { "expr": "qbittorrent_tracker_downloaded_bytes{instance=~\"$instance\"}", "format": "table", "instant": true, "refId": "D" },
        { "expr": "qbittorrent_tracker_ratio{instance=~\"$instance\"}", "format": "table", "instant": true, "refId": "R" },
        { "expr": "qbittorrent_tracker_torrents_count{instance=~\"$instance\"}", "format": "table", "instant": true, "refId": "T" }
      ]
    }
  ]
}
